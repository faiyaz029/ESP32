  document.getElementById('lightVal').textContent = val;
  document.getElementById('brightnessVal').textContent = val;
  document.getElementById('lightSlider').value = val;
  fetch(`/cmd?do=LIGHT_${val}`).then(r => r.text()).then(t => console.log(t));
}

