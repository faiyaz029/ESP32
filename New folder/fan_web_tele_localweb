// Handler to update fan speed based on query parameter 'mode' from the local webpage
void handleSetFan() {
  if (server.hasArg("mode")) {
    String mode = server.arg("mode");
    if (mode == "slow") {
      setFanSpeed(0, "Slow");
    } else if (mode == "medium") {
      setFanSpeed(170, "Medium");
    } else if (mode == "fast") {
      setFanSpeed(255, "Fast");
    }
    // Redirect back to the dashboard after fan mode change
    server.sendHeader("Location", "/", true);
    server.send(302, "text/plain", "");
    return;
  }
  server.send(400, "text/plain", "Bad Request");
}

// Get current formatted time (from NTP sync) for display in the dashboard
String getFormattedTime() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    return "Time not available";
  }
  char buf[30];
  strftime(buf, sizeof(buf), "%Y-%m-%d %I:%M:%S %p", &timeinfo);
  return String(buf);
}
