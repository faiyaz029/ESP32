#include <WiFi.h>
#include <WiFiClient.h>
#include <WebServer.h>
#include <ESPmDNS.h>
#include <DHT.h>
#include <time.h>

// WiFi credentials
const char *ssid = "twogsimp";
const char *password = "ami2G#sImPeR";

// DHT setup
#define DHTPIN 15
#define DHTTYPE DHT22
DHT dht(DHTPIN, DHTTYPE);

// Web server
WebServer server(80);

// Setup WiFi and NTP time
void setup(void) {
  Serial.begin(115200);
  dht.begin();

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  Serial.println("");

  // Wait for connection
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.print("Connected to ");
  Serial.println(ssid);
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());

  // Start mDNS
  if (MDNS.begin("fztemp")) {
    Serial.println("MDNS responder started");
  }

  // Setup NTP
  configTime(0, 0, "pool.ntp.org"); // UTC time
  Serial.println("Waiting for time sync...");
  struct tm timeinfo;
  while (!getLocalTime(&timeinfo)) {
    Serial.print(".");
    delay(500);
  }
  Serial.println("");
  Serial.println("Time synchronized!");

  // Setup HTTP server
  server.on("/", handleRoot);
  server.begin();
  Serial.println("HTTP server started");
}

// Main loop
void loop(void) {
  server.handleClient();
  delay(2); // allow CPU to switch to other tasks
}

